#!/bin/sh
# Blocks commits containing game files or anything outside our allowlist.
# Enable once per clone:  git config core.hooksPath .githooks
# Pick the first interpreter that actually runs (Windows has a python3 Store stub).
for PY in python3 python py; do
  if "$PY" -c "import sys" >/dev/null 2>&1; then
    "$PY" tools/check_no_game_files.py || exit 1
    "$PY" tools/build_balance.py --check || exit 1
    "$PY" tools/build_codex.py --check || exit 1
    exec "$PY" tools/gsc_lint.py
  fi
done
echo "pre-commit: no working Python found; cannot verify no game files are staged." >&2
exit 1
